# Copy only as a template. No secrets or funded users are included.
# npm run setup:dev creates a gitignored development .env with random secrets.
NODE_ENV=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_SCHEMA=public
DB_SSL=false
PORT=8080
API_VERSION=v1
JWT_MODE=development_hmac
JWT_ISSUER=https://sharebondhu-development.invalid
JWT_AUDIENCE=sharebondhu-development
JWT_DEV_SECRET=
RISK_HASH_KEY=
PROVIDER_HMAC_KEYS_JSON={}
ALLOW_ACCOUNT_REGISTRATION=false
REWARDS_ENABLED=false
CORS_ORIGINS=
TRUST_PROXY_CIDRS=
TRACKING_ORIGINS=
LOG_REQUESTS=true
